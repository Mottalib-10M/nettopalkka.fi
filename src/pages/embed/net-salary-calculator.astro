---
/** Upotettava sivu (iframe): laskuri ilman navigaatiota. noindex, ei sivukartassa (astro.config). */
import '../../styles/global.css';
import NettoLaskuri from '../../components/calc/NettoLaskuri';
import { SITE_URL } from '../../data/site-config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Finland net salary calculator 2026</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <NettoLaskuri client:load lang="en" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">Finland net salary calculator 2026</a></p>
  </body>
</html>
