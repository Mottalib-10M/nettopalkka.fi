---
/**
 * Etusivu (pilari, RECETTE §5) : otsikko ja luottamusrivi, lainattava kappale taitettuna, nettopalkkalaskuri,
 * kuntien verotaulukot (matalin ja korkein), suurten kaupunkien vertailu moottorista, laskurihakemisto,
 * teksti src/content/home.ts:stä. UKK ja lähteet PageLayoutista.
 */
import PageLayout from '../layouts/PageLayout.astro';
import NettoLaskuri from './calc/NettoLaskuri';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/engine/params';
import { jarjestetty, netto, KUNTIA, VERO_ESIMERKKEJA } from '../lib/esimerkit';
import { kuntaryhma } from '../lib/engine/asumistuki';
import { formatMoney, formatNumber, displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LAST_UPDATED, LANG_TAGS } from '../data/site-config';
import { pageById } from '../lib/guides';
interface Props { lang: Locale }
const { lang } = Astro.props;
const fi = lang === 'fi';
const x = HOME[lang];
const h = helpers(lang);
const path = route('home', lang);
const faqs = x.faqs(h);
const keys: SourceKey[] = ['vero_kunnat', 'vero_ennakonpidatys', 'vero_asteikko', 'vero_veroperusteet', 'vero_esimerkit', 'finlex_tvl', 'etk_maksut'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const $ = (n: number) => formatMoney(n, 0, lang);
const f2 = (n: number) => formatNumber(n, 2, lang);
const matalimmat = jarjestetty(1).slice(0, 10);
const korkeimmat = jarjestetty(-1).slice(0, 10);
const kaupungit = ['Helsinki', 'Espoo', 'Vantaa', 'Tampere', 'Turku', 'Oulu', 'Jyväskylä', 'Kuopio', 'Lahti', 'Maarianhamina'];
const kaupunkiRivit = kaupungit.map((k) => ({ k, n25: netto(2500, k).netto / 12, n35: netto(3500, k).netto / 12, n50: netto(5000, k).netto / 12, ryhma: kuntaryhma(k), r: netto(3500, k).kunta.kunta }));
const kaupunkiSivu: Record<string, string> = { Helsinki: 'helsinki', Espoo: 'espoo', Vantaa: 'vantaa', Tampere: 'tampere', Turku: 'turku', Oulu: 'oulu', Jyväskylä: 'jyvaskyla', Kuopio: 'kuopio', Lahti: 'lahti', Maarianhamina: 'ahvenanmaa' };
const has = (id: string) => ROUTES.some((r) => r.id === id);
const hakemisto: Array<{ otsikko: string; ids: string[] }> = [
  { otsikko: fi ? 'Palkka ja verot' : 'Pay and tax', ids: ['veroprosenttilaskuri', 'bruttopalkka-laskuri', 'verolaskuri', 'kuntavertailu', 'lomaraha-laskuri'] },
  { otsikko: fi ? 'Eläke' : 'Pension', ids: ['elakelaskuri', 'takuuelake-laskuri', 'elakeika', 'elakkeen-verotus'] },
  { otsikko: fi ? 'Kela ja työttömyys' : 'Kela and unemployment', ids: ['asumistuki-laskuri', 'ansiosidonnainen-laskuri', 'vanhempainpaivaraha-laskuri', 'yleistuki', 'kotitalousvahennys-laskuri'] },
].map((g) => ({ ...g, ids: g.ids.filter(has) }));
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-5">
    <h1 class="text-3xl font-bold text-navy-900 md:text-[2.6rem] md:leading-tight">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-3 text-sm text-navy-700">
      {fi ? 'Vuoden 2026 veroperusteet, tarkistettu' : '2026 tax rules, checked on'} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, LANG_TAGS[lang])}</time> · {fi ? `${KUNTIA} kunnan veroprosentit` : `rates of all ${KUNTIA} municipalities`} · {fi ? `${VERO_ESIMERKKEJA} Verohallinnon esimerkkiä täsmää` : `${VERO_ESIMERKKEJA} Vero examples matched`} · <a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a>
    </p>
  </header>
  <Clamp text={x.resume(h)} lang={lang} id="clamp-home" sentences={2} class="mb-6" />
  <div data-outil><NettoLaskuri client:load lang={lang} methodHref={route('method', lang)} /></div>

  <section class="mt-12 border-t border-navy-200 pt-6" aria-labelledby="kunnat">
    <h2 id="kunnat" class="text-2xl font-bold text-navy-900">{fi ? 'Kunnallisvero 2026: matalimmat ja korkeimmat' : 'Municipal tax 2026: lowest and highest'}</h2>
    <p class="mt-2 text-navy-700">{fi ? 'Manner-Suomen kunnat. Ahvenanmaan veromalli on erilainen, katso alempaa.' : 'Mainland municipalities. Åland has a different tax model, see further down.'} {has('kuntavertailu') && <a class="underline" href={route('kuntavertailu', lang)}>{fi ? `Kaikki ${KUNTIA} kuntaa ja nettopalkka kunnittain` : `All ${KUNTIA} municipalities with net pay`}</a>}</p>
    <div class="mt-4 grid gap-6 md:grid-cols-2">
      {[{ t: fi ? 'Matalin kunnallisvero' : 'Lowest municipal tax', rows: matalimmat }, { t: fi ? 'Korkein kunnallisvero' : 'Highest municipal tax', rows: korkeimmat }].map((b) => (
        <div class="not-prose overflow-x-auto">
          <table class="w-full text-sm">
            <caption class="mb-2 text-left text-sm font-semibold text-navy-800">{b.t}</caption>
            <thead><tr><th scope="col" class="border-b border-navy-300 py-2 text-left">{fi ? 'Kunta' : 'Municipality'}</th><th scope="col" class="border-b border-navy-300 text-right">{fi ? 'Vero' : 'Rate'}</th><th scope="col" class="border-b border-navy-300 text-right">{fi ? 'Netto, 3 500 €' : 'Net on €3,500'}</th></tr></thead>
            <tbody>{b.rows.map((k) => <tr class="border-t border-navy-100"><th scope="row" class="py-1.5 text-left font-normal">{k.nimi}</th><td class="tabular-nums text-right">{f2(k.kunta)} %</td><td class="tabular-nums text-right">{$(netto(3500, k.nimi).netto / 12)}</td></tr>)}</tbody>
          </table>
        </div>
      ))}
    </div>
  </section>

  <section class="mt-12 border-t border-navy-200 pt-6" aria-labelledby="kaupungit">
    <h2 id="kaupungit" class="text-2xl font-bold text-navy-900">{fi ? 'Kymmenen kaupunkia rinnakkain' : 'Ten cities side by side'}</h2>
    <p class="mt-2 text-navy-700">{fi ? 'Nettopalkka kuukaudessa ilman kirkollisveroa, 17–64-vuotias, ei lapsia. Viimeinen sarake on Kelan asumistuen kuntaryhmä, joka ratkaisee hyväksyttävät asumismenot.' : 'Net pay per month without church tax, age 17 to 64, no children. The last column is the Kela housing allowance group, which sets the accepted housing costs.'}</p>
    <div class="not-prose mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr><th scope="col" class="border-b border-navy-300 py-2 text-left">{fi ? 'Kaupunki' : 'City'}</th><th scope="col" class="border-b border-navy-300 text-right">{fi ? 'Kunnallisvero' : 'Municipal tax'}</th><th scope="col" class="border-b border-navy-300 text-right">2 500 €</th><th scope="col" class="border-b border-navy-300 text-right">3 500 €</th><th scope="col" class="border-b border-navy-300 text-right">5 000 €</th><th scope="col" class="border-b border-navy-300 text-right">{fi ? 'Asumistuki' : 'Housing'}</th></tr></thead>
        <tbody>{kaupunkiRivit.map((r) => <tr class="border-t border-navy-100"><th scope="row" class="py-1.5 text-left font-medium">{has(kaupunkiSivu[r.k]) ? <a class="underline" href={route(kaupunkiSivu[r.k], lang)}>{r.k}</a> : r.k}</th><td class="tabular-nums text-right">{f2(r.r as number)} %</td><td class="tabular-nums text-right">{$(r.n25)}</td><td class="tabular-nums text-right font-semibold">{$(r.n35)}</td><td class="tabular-nums text-right">{$(r.n50)}</td><td class="text-right">{r.ryhma === 'Ahvenanmaa' ? (fi ? 'Ahvenanmaa' : 'Åland') : r.ryhma}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <div class="prose prose-slate mt-12 max-w-none border-t border-navy-200 pt-4">
    <Fragment set:html={x.body(h)} />
  </div>

  <aside class="mt-12 border-t border-navy-200 pt-6" aria-labelledby="hakemisto" data-chrome>
    <h2 id="hakemisto" class="text-2xl font-bold text-navy-900">{fi ? 'Kaikki laskurit' : 'All calculators'}</h2>
    <div class="mt-4 grid gap-6 md:grid-cols-3">
      {hakemisto.map((g) => (
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-wide text-navy-700">{g.otsikko}</h3>
          <dl class="mt-2 space-y-2">{g.ids.map((id) => <div><dt><a class="font-medium text-accent-700 underline" href={route(id, lang)}>{label(id, lang)}</a></dt><dd class="text-sm text-navy-600">{pageById(id)?.[lang].card}</dd></div>)}</dl>
        </div>
      ))}
    </div>
  </aside>
</PageLayout>
