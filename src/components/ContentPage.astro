---
/**
 * Laskuri- tai oppaan sivu `src/content/pages/`-tiedostosta. Järjestys (RECETTE §9.3, §21): H1 ja johdanto;
 * laskurisivu: lainattava kappale (taitettu) ja laskuri; opas: lainattava kappale, minilaskuri, teksti.
 * UKK, liittyvät sivut, lähteet ja tekijälaatikko tulevat PageLayoutista (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import NettoLaskuri from './calc/NettoLaskuri';
import BruttoLaskuri from './calc/BruttoLaskuri';
import VeroprosenttiLaskuri from './calc/VeroprosenttiLaskuri';
import VeroLaskuri from './calc/VeroLaskuri';
import KuntaVertailu from './calc/KuntaVertailu';
import ElakeLaskuri from './calc/ElakeLaskuri';
import KansanelakeLaskuri from './calc/KansanelakeLaskuri';
import AsumistukiLaskuri from './calc/AsumistukiLaskuri';
import KotitalousLaskuri from './calc/KotitalousLaskuri';
import AnsiopaivarahaLaskuri from './calc/AnsiopaivarahaLaskuri';
import VanhempainpaivarahaLaskuri from './calc/VanhempainpaivarahaLaskuri';
import LomarahaLaskuri from './calc/LomarahaLaskuri';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const parts = x.body(helpers(lang)).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: x.h1, description: x.description, path, lang }));
if (x.faqs.length) jsonLd.push(faqSchema(x.faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
const cible = page.miniHref ?? 'home';
const miniHref = ROUTES.some((r) => r.id === cible) ? route(cible, lang) : undefined;
const preset = (page.toolPreset ?? {}) as Record<string, never>;
const palkkaPreset = typeof page.toolPreset?.palkka === 'number' ? page.toolPreset.palkka : undefined;
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={x.faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-6">
      <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={x.resume} lang={lang} id={`clamp-${page.id}`} class="mb-6" />
        <div data-outil>
          {page.tool === 'netto' && <NettoLaskuri client:load lang={lang} methodHref={methodHref} preset={preset} palkka={palkkaPreset} />}
          {page.tool === 'brutto' && <BruttoLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'veroprosentti' && <VeroprosenttiLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'verolaskuri' && <VeroLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'kunnat' && <KuntaVertailu client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'elake' && <ElakeLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'kansanelake' && <KansanelakeLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'asumistuki' && <AsumistukiLaskuri client:load lang={lang} methodHref={methodHref} preset={preset} />}
          {page.tool === 'kotitalous' && <KotitalousLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'ansiopaivaraha' && <AnsiopaivarahaLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'vanhempainpaivaraha' && <VanhempainpaivarahaLaskuri client:load lang={lang} methodHref={methodHref} />}
          {page.tool === 'lomaraha' && <LomarahaLaskuri client:load lang={lang} methodHref={methodHref} />}
        </div>
      </>
    ) : (
      <>
        <p class="mb-6 text-navy-800">{x.resume}</p>
        {page.mini && <MiniSim client:load kind={page.mini} lang={lang} href={miniHref} defaults={page.miniDefaults} />}
      </>
    )}
    <div class="prose prose-slate mt-8 max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={miniHref} />)}
    </div>
  </article>
</PageLayout>
