---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/net-salary-calculator/" title="Finland net salary calculator 2026" width="100%" height="1200" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Finland net salary calculator 2026 on your site" description="Embed the 2026 Finnish net salary calculator with all 308 municipal tax rates on your site for free: copy the code, no sign-up, no tracking, everything runs in the browser." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed a calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed a calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One snippet, no sign-up, no fee. Expat groups, relocation pages and newsrooms add it in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the link under the calculator visible, do not modify the calculator, no warranty. Values and tests are updated here, so your embed stays current. Finnish version: <code>{`${SITE_URL}/embed/nettopalkkalaskuri/`}</code>.</p>
    <p>Nothing about your visitors reaches us: the maths runs in their browser and the frame sets no cookies. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/net-salary-calculator/" title="Finland net salary calculator 2026" width="100%" height="1200" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
