---
import PageLayout from '../../layouts/PageLayout.astro';
import { CONTACT_EMAIL, LAST_UPDATED } from '../../data/site-config';
import { route } from '../../i18n/routes';
const lang = 'fi';
---
<PageLayout title="Evästeet: Nettopalkka ei aseta yhtään evästettä" description="Nettopalkka-, vero-, eläke- ja Kela-laskurit eivät aseta evästeitä eivätkä tallenna sinusta mitään. Sivuston vakautta seurataan nimettömästi Microsoft Claritylla ilman evästeitä." lang={lang} noindex={true} breadcrumbs={[{ label: 'Evästeet' }]} showAuthor={false}>
  <div class="prose prose-slate max-w-none">
    <h1>Evästeet</h1>
    <p>Täydentää <a href={route('privacy', lang)}>tietosuojaselostetta</a>.</p>
    <h2>Ei evästeitä</h2><p>Sivusto ei aseta evästeitä millään sivulla, eivätkä laskurit tallenna laitteellesi mitään: palkka, kotikunta ja muut syötteet pysyvät avoimella sivulla ja katoavat, kun suljet sen. Siksi sivustolla ei ole evästebanneria: hyväksyttävää ei ole.</p>
    <h2>Vakauden nimetön seuranta</h2><p>Rikkinäisten sivujen, skriptivirheiden, hitaiden latausten ja toimimattomien painikkeiden havaitsemiseksi sivusto lataa Microsoft Clarityn evästeettömässä tilassa. Clarity ei silloin aseta evästeitä (ei <code>_clck</code>, <code>_clsk</code>, <code>MUID</code> eikä <code>CLID</code>), antaa jokaiselle sivunlataukselle oman kertakäyttöisen tunnisteen eikä yhdistä käyntejäsi toisiinsa. Sivujen sisältö ja syötteet peitetään ennen kuin mitään lähetetään.</p>
    <h2>Estäminen</h2><p>Jos et halua tätäkään mittausta, estä verkkotunnus clarity.ms tai käytä sisällönestoa; laskurit toimivat täsmälleen samoin.</p>
    <p>Kysymykset: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. Päivitetty {LAST_UPDATED}.</p>
  </div>
</PageLayout>
